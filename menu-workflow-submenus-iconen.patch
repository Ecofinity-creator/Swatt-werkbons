+/** Uitloggen. */
+export function LogoutIcon(props: IconProps) {
+  return base(
+    props,
+    <>
+      <path d="M9 21H5.5A1.5 1.5 0 0 1 4 19.5v-15A1.5 1.5 0 0 1 5.5 3H9" />
+      <path d="M16.5 16.5 21 12l-4.5-4.5" />
+      <path d="M21 12H9" />
+    </>,
+  );
+}
