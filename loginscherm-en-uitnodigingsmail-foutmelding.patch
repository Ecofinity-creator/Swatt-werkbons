 apps/web/src/pages/admin/UserDetailPage.tsx   |  2 +-
 apps/web/src/pages/admin/UsersPage.tsx        |  4 ++-
 packages/shared-types/src/index.ts            | 14 ++++++++
 7 files changed, 87 insertions(+), 13 deletions(-)

