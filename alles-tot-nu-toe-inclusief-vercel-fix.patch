+function isoWeekKeyOf(date: Date): string {
+  const d = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()));
+  const dayNumber = (d.getUTCDay() + 6) % 7;
+  d.setUTCDate(d.getUTCDate() - dayNumber + 3);
