{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && npm ci && npm run build --workspace=packages/shared-types && npm run build --workspace=apps/web",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/health", "destination": "https://swatt-api.onrender.com/health" },
    { "source": "/auth/:path*", "destination": "https://swatt-api.onrender.com/auth/:path*" },
    { "source": "/admin/:path*", "destination": "https://swatt-api.onrender.com/admin/:path*" },
    { "source": "/projects", "destination": "https://swatt-api.onrender.com/projects" },
    { "source": "/projects/:path*", "destination": "https://swatt-api.onrender.com/projects/:path*" },
    { "source": "/teamleader/status", "destination": "https://swatt-api.onrender.com/teamleader/status" },
    {
      "source": "/teamleader/oauth/prepare-authorize",
      "destination": "https://swatt-api.onrender.com/teamleader/oauth/prepare-authorize"
    },
    {
      "source": "/teamleader/oauth/disconnect",
      "destination": "https://swatt-api.onrender.com/teamleader/oauth/disconnect"
    },
    { "source": "/time-entries", "destination": "https://swatt-api.onrender.com/time-entries" },
    { "source": "/time-entries/:path*", "destination": "https://swatt-api.onrender.com/time-entries/:path*" },
    { "source": "/work-orders", "destination": "https://swatt-api.onrender.com/work-orders" },
    { "source": "/work-orders/:path*", "destination": "https://swatt-api.onrender.com/work-orders/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
