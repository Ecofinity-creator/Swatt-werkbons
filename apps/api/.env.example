# Kopieer naar .env voor lokale ontwikkeling (nooit .env committen).
NODE_ENV=development
PORT=3000

# Lokaal (docker-compose): postgres/postgres@localhost:5432/swatt_dev
DATABASE_URL="postgresql://swatt:swatt_dev_local@localhost:5432/swatt_dev"

# Genereer lokaal met: openssl rand -hex 32
SESSION_COOKIE_SECRET="vervang-dit-door-minstens-32-random-tekens"

CORS_ORIGINS="http://localhost:5173"
COOKIE_SECURE=false
