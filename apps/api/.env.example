# Kopieer naar .env voor lokale ontwikkeling (nooit .env committen).
NODE_ENV=development
PORT=3000

# Lokaal (docker-compose): postgres/postgres@localhost:5432/swatt_dev
DATABASE_URL="postgresql://swatt:swatt_dev_local@localhost:5432/swatt_dev"

# Genereer lokaal met: openssl rand -hex 32
SESSION_COOKIE_SECRET="vervang-dit-door-minstens-32-random-tekens"

CORS_ORIGINS="http://localhost:5173"
COOKIE_SECURE=false

# Teamleader OAuth (Phase 2) — optioneel: laat leeg/weg zolang je nog geen
# Teamleader-marketplace-app geregistreerd hebt (developer.focus.teamleader.eu).
# Ofwel alle vier gezet, ofwel geen enkele — zie apps/api/src/config/env.ts.
TEAMLEADER_CLIENT_ID=
TEAMLEADER_CLIENT_SECRET=
# Moet exact overeenkomen met de redirect-URI die bij de Teamleader-app geregistreerd staat.
TEAMLEADER_REDIRECT_URI="http://localhost:3000/teamleader/oauth/callback"
# Genereer lokaal met: openssl rand -base64 32
TEAMLEADER_TOKEN_ENCRYPTION_KEY=
