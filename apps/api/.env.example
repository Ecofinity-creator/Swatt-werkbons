# Kopieer naar .env voor lokale ontwikkeling (nooit .env committen).
NODE_ENV=development
PORT=3000

# Lokaal (docker-compose): postgres/postgres@localhost:5432/swatt_dev
DATABASE_URL="postgresql://swatt:swatt_dev_local@localhost:5432/swatt_dev"

# Genereer lokaal met: openssl rand -hex 32
SESSION_COOKIE_SECRET="vervang-dit-door-minstens-32-random-tekens"

CORS_ORIGINS="http://localhost:5173"
COOKIE_SECURE=false

# Teamleader OAuth (Phase 2) — optioneel: laat leeg/weg zolang je nog geen
# Teamleader-marketplace-app geregistreerd hebt (developer.focus.teamleader.eu).
# Ofwel alle vier gezet, ofwel geen enkele — zie apps/api/src/config/env.ts.
TEAMLEADER_CLIENT_ID=
TEAMLEADER_CLIENT_SECRET=
# Moet exact overeenkomen met de redirect-URI die bij de Teamleader-app geregistreerd staat.
TEAMLEADER_REDIRECT_URI="http://localhost:3000/teamleader/oauth/callback"
# Genereer lokaal met: openssl rand -base64 32
TEAMLEADER_TOKEN_ENCRYPTION_KEY=

# Phase 9 — BullMQ-syncqueue (sectie 15). Optioneel: valt terug op deze
# default (matcht de Redis uit docker-compose.yml) zolang je die niet
# expliciet zet — zie apps/api/src/config/env.ts.
REDIS_URL="redis://localhost:6379"

# E-mail (uitnodigingen + wachtwoord-vergeten) via Resend (resend.com) —
# optioneel: laat beide leeg/weg zolang je nog geen Resend-account hebt.
# Ofwel allebei gezet, ofwel geen enkele — zie apps/api/src/config/env.ts.
# Zonder configuratie werkt de rest van de app gewoon door (business rule 9):
# een nieuwe gebruiker wordt dan aangemaakt zonder uitnodigingsmail, en moet
# via "Wachtwoord vergeten" een wachtwoord instellen zodra dit wél geconfigureerd is.
RESEND_API_KEY=
# Moet een geverifieerd verzenddomein zijn in Resend, of tijdens het testen
# de Resend-sandboxafzender "onboarding@resend.dev" (levert enkel af aan het
# e-mailadres van je eigen Resend-account).
EMAIL_FROM_ADDRESS=
