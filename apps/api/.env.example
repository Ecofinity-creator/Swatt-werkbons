# Kopieer dit bestand naar `.env` en vul de echte waarden in — NOOIT een
# echt wachtwoord/secret in dit .env.example-bestand zelf committen (dat
# belandt anders in de git-geschiedenis, zie claude/phase25-secret-lek-env-example.md).

NODE_ENV=development
PORT=3000

# Lokaal (via docker compose up -d): postgresql://swatt:swatt_dev_local@localhost:5432/swatt
# Productie (Render): automatisch ingevuld via render.yaml's `fromDatabase` — hier niet nodig.
DATABASE_URL=postgresql://swatt:swatt_dev_local@localhost:5432/swatt

# Minstens 32 tekens. Lokaal: genereer met `openssl rand -hex 32`.
# Productie (Render): automatisch gegenereerd via render.yaml (`generateValue: true`).
SESSION_COOKIE_SECRET=vervang-dit-door-een-echte-random-string-van-minstens-32-tekens

# Komma-gescheiden lijst van origins die de frontend mag hebben. De EERSTE
# waarde moet altijd de echte frontend-URL zijn (ook gebruikt als
# terugkeer-URL na de Teamleader OAuth-callback).
CORS_ORIGINS=http://localhost:5173

# 'true' in productie (HTTPS via Vercel/Render), 'false' lokaal.
COOKIE_SECURE=false

# Optioneel: geheim voor de eenmalige /admin/seed-route (eerste ADMIN-gebruiker
# aanmaken via de browser). Minstens 16 tekens. Productie (Render): automatisch
# gegenereerd via render.yaml.
SEED_TOKEN=

# Teamleader OAuth2 — optioneel, maar als je er één zet moeten alle vier gezet
# zijn. Registreer een integratie op developer.focus.teamleader.eu (zie
# README.md "Teamleader koppelen").
TEAMLEADER_CLIENT_ID=
TEAMLEADER_CLIENT_SECRET=
# Moet exact overeenkomen met de redirect-URI die bij de Teamleader-app
# geregistreerd staat, bv. https://<jouw-backend>.onrender.com/teamleader/oauth/callback
TEAMLEADER_REDIRECT_URI=
# base64-encoded AES-256-sleutel. Genereer met: openssl rand -base64 32
TEAMLEADER_TOKEN_ENCRYPTION_KEY=

# E-mailverzending (Resend) — optioneel, maar samen gezet.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS="Uurivo <onboarding@resend.dev>"

# Kilometervergoeding (geocoding/routing) — optioneel, één van beide volstaat.
OPENROUTESERVICE_API_KEY=
HERE_API_KEY=

# BullMQ-achtergrondwerker. Lokaal (via docker compose up -d): redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Demo-/testmodus: laat de Teamleader-syncworker meedraaien in dit proces
# i.p.v. als aparte service (nodig zolang je op Render's gratis plan zit,
# dat geen Background Worker-services ondersteunt).
RUN_SYNC_WORKER_INLINE=false

# Aantal uren dat een DRAFT-werkbon onaangeroerd mag blijven vóór een
# herinneringsmail naar de medewerker gaat.
WORK_ORDER_REMINDER_THRESHOLD_HOURS=24
