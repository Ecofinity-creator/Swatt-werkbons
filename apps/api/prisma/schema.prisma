// Phase 1 (Foundation): enkel de tabellen die de auth/RBAC-flow nodig heeft.
// Verdere entities (Customer, Project, TimeEntry, WorkOrder, ...) komen in latere
// fases (zie Stap 6 — development roadmap) — bewust niet allemaal in één keer,
// conform "werk iteratief, kleine gecontroleerde wijzigingen" (ontwikkelregels).
//
// Kolomnamen/tabelnamen zijn bewust identiek aan het datamodel uit Stap 4
// (snake_case tabellen/kolommen via @@map/@map) zodat dit schema en dat
// ontwerpdocument nooit uit elkaar kunnen groeien.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext]
}

enum UserRole {
  EMPLOYEE
  SUPERVISOR
  ADMIN

  @@map("user_role")
}

enum TeamleaderConnectionStatus {
  DISCONNECTED
  CONNECTED
  ERROR

  @@map("teamleader_connection_status")
}

/// Welke Teamleader-projectenmodule het gekoppelde account gebruikt — de twee
/// modules zijn onderling incompatibel (bevestigd via het officiële
/// support-artikel "New Teamleader Focus API Project Endpoints": een account
/// gebruikt exact één van beide, nooit allebei). Zie ProjectSyncService
/// (Phase 3) voor hoe dit gedetecteerd wordt via `accounts.projects-v2-status`.
enum TeamleaderProjectsModule {
  LEGACY
  PROJECTS_V2

  @@map("teamleader_projects_module")
}

/// Phase 4 — timer ("START WERK"). RUNNING → PAUSED (herhaaldelijk mogelijk) → RUNNING,
/// en uiteindelijk RUNNING/PAUSED → STOPPED (eindstatus, geen terugweg). Zie
/// TimeEntryService voor de overgangslogica.
enum TimeEntryStatus {
  RUNNING
  PAUSED
  STOPPED

  @@map("time_entry_status")
}

/// Phase 5 — werkbonnen (basis). Statusnamen matchen het overzicht uit sectie 20
/// van de projectbrief. Deze ronde gebruikt enkel DRAFT (een werkbon wordt
/// automatisch aangemaakt zodra de timer gestopt wordt); de volledige enum
/// staat hier al klaar zodat de latere fases (handtekening, Teamleader-sync,
/// facturatie — Phase 7/9/10) geen schema-migratie nodig hebben die bestaande
/// rijen zou raken.
enum WorkOrderStatus {
  DRAFT
  READY_FOR_SIGNATURE
  SIGNED
  SYNC_PENDING
  SYNC_FAILED
  READY_FOR_INVOICING
  INVOICED

  @@map("work_order_status")
}

/// Phase 6 — foto's op een werkbon (sectie 9 van de projectbrief). Categorie
/// is optioneel (zie WorkOrderPhoto.category); deze lijst matcht de
/// voorbeeldcategorieën uit sectie 9 letterlijk.
enum WorkOrderPhotoCategory {
  SITUATIE_VOOR
  UITVOERING
  SITUATIE_NA
  SERIENUMMER
  TECHNISCHE_INSTALLATIE
  PROBLEEM_SCHADE
  OVERIGE

  @@map("work_order_photo_category")
}

/// Phase 8 — PDF-generatie (sectie 12/13/31). Bewust losgekoppeld van de
/// Teamleader-upload-statussen (TEAMLEADER_UPLOAD_* uit sectie 13) — die
/// horen bij Phase 9. Section 31: "PDF EN TEAMLEADER MOETEN LOSGEKOPPELD
/// ZIJN" — deze enum bewaakt enkel of ONZE eigen PDF succesvol is opgebouwd
/// en opgeslagen, los van of/wanneer die nadien ooit naar Teamleader gaat.
enum WorkOrderPdfStatus {
  PDF_PENDING
  PDF_GENERATING
  PDF_READY
  PDF_FAILED

  @@map("work_order_pdf_status")
}

/// Phase 9 — Teamleader-sync (sectie 13/14/15/31). Bewust een APARTE enum van
/// WorkOrderPdfStatus hierboven (sectie 31: "PDF EN TEAMLEADER MOETEN
/// LOSGEKOPPELD ZIJN") — dit bewaakt enkel of ONZE eigen, al-gegenereerde PDF
/// intussen ook effectief als bestand in Teamleader staat, los van de
/// PDF-generatie zelf. Naamgeving letterlijk uit sectie 13 van de brief.
enum WorkOrderTeamleaderUploadStatus {
  TEAMLEADER_UPLOAD_PENDING
  TEAMLEADER_UPLOADED
  TEAMLEADER_UPLOAD_FAILED

  @@map("work_order_teamleader_upload_status")
}

/// Phase 9 — sync-status per tijdsregistratie (sectie 14). NOT_SYNCED is de
/// starttoestand voor elke nieuwe TimeEntry (ongeacht of ze ooit gesynchroniseerd
/// zal worden — enkel tijdsregistraties die uiteindelijk in een ondertekende
/// werkbon terechtkomen doorlopen PENDING → SYNCED/FAILED, zie TimeTrackingSyncService).
enum TimeEntrySyncStatus {
  NOT_SYNCED
  PENDING
  SYNCED
  FAILED

  @@map("time_entry_sync_status")
}

/// Phase 9 — het type achtergrondwerk achter één SyncJob-rij (sectie 15/23).
/// Bewust twee aparte types (i.p.v. één gecombineerde "sync werkbon"-job) zodat
/// een mislukte PDF-upload de tijdsregistratie-sync niet blokkeert en
/// omgekeerd — elk kan onafhankelijk hersynchroniseren (sectie 13: "Een
/// mislukte Teamleader upload mag NOOIT leiden tot verlies van de werkbon").
enum SyncJobType {
  TIME_ENTRIES
  PDF_UPLOAD

  @@map("sync_job_type")
}

enum SyncJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED

  @@map("sync_job_status")
}

/// Phase 10 — facturatiebatches (sectie 17). Deze ronde wordt enkel DRAFT
/// bereikt (een lokale "voorbereid voor facturatie"-groepering) — het
/// automatisch aanmaken van een echte Teamleader-conceptfactuur
/// (`invoices.draft`, zie claude/phase10-facturatie-onderzoek.md) is een
/// volgende stap die eerst een productbeslissing over het uurtarief nodig
/// heeft. De volledige enum staat hier al klaar zodat die latere stap geen
/// migratie nodig heeft die bestaande batches raakt.
enum InvoiceBatchStatus {
  DRAFT
  SUBMITTED_TO_TEAMLEADER
  INVOICED

  @@map("invoice_batch_status")
}

enum SyncLogStatus {
  STARTED
  SUCCEEDED
  FAILED

  @@map("sync_log_status")
}

/// Phase 12, deel A (sectie 1): ploegenwerk- en nachtwerktoeslag sluiten
/// elkaar uit op een ProjectAssignment (radiovakjes in de UI) — overuren
/// (ProjectAssignment.overtimeApplies) staat er onafhankelijk naast.
enum PremiumType {
  NONE
  SHIFT_WORK
  NIGHT_WORK

  @@map("premium_type")
}

/// Phase 12, deel A — bepaalt op Project-niveau of de overurendrempel per dag
/// (vast 8u) of per week (Project.overtimeWeeklyThresholdHours) geldt.
enum OvertimeThresholdType {
  DAILY
  WEEKLY

  @@map("overtime_threshold_type")
}

/// Phase 12, deel E — status van een personeelsuitbetaling-batch, zelfde
/// vorm als InvoiceBatchStatus maar zonder Teamleader-synchronisatiestappen
/// (uitbetaling gebeurt buiten deze app om, via de loonadministratie).
enum PayrollBatchStatus {
  DRAFT
  CLOSED

  @@map("payroll_batch_status")
}

/// Phase 12, deel B (sectie 2): "Werkbonnen per week laten tekenen door de
/// klant" — instelbaar per project, niet systeembreed (sommige klanten
/// tekenen liever nog per interventie).
enum SigningMode {
  PER_WORK_ORDER
  WEEKLY

  @@map("signing_mode")
}

enum WeeklyApprovalStatus {
  OPEN
  SIGNED
  REOPENED

  @@map("weekly_approval_status")
}

/// Werknemer vs. Onderaannemer op de medewerkerskaart (backlog-item 30/8,
/// zie claude/projectoverdracht-samenvatting_2.md sectie 3.3). Bepaalt welk
/// soort urenoverzicht deze persoon krijgt bij de maandelijkse export — zie
/// het hours-export-modules (HoursExportService):
/// - EMPLOYEE: opgenomen in de gedeelde Excel-urenexport (ruwe urenlijst,
///   bedoeld voor eigen loonverwerking).
/// - SUBCONTRACTOR: een apart totalisatie-met-detail-PDF-document per
///   onderaannemer/periode, bedoeld om naar de onderaannemer te sturen zodat
///   die er zelf op kan factureren — dus bewust GEEN ruwe urenlijst.
enum EmploymentType {
  EMPLOYEE
  SUBCONTRACTOR

  @@map("employment_type")
}

model User {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email  String   @unique @db.Citext
  /// Null zolang de gebruiker (via een uitnodigingsmail) nog geen wachtwoord
  /// heeft ingesteld — zie PasswordSetupToken hieronder en AuthService.login,
  /// die dit expliciet en met een duidelijke foutmelding afvangt i.p.v. te
  /// crashen op een null-vergelijking.
  passwordHash String? @map("password_hash")
  role         UserRole @default(EMPLOYEE)
  isActive     Boolean  @default(true) @map("is_active")

  /// Extern Teamleader user-ID; nullable tot gekoppeld (zie ProjectSyncService, Phase 3).
  teamleaderUserId String? @unique @map("teamleader_user_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  employee Employee?
  sessions Session[]

  /// Admins die ooit (het laatst) de Teamleader-koppeling gelegd hebben.
  /// Zie TeamleaderConnection — meestal maar 0 of 1 rij, want die tabel is zelf een singleton.
  connectedTeamleaderConnections TeamleaderConnection[]

  /// Admins/supervisors die ooit een ProjectAssignment gelegd hebben (Phase 3).
  createdProjectAssignments ProjectAssignment[]

  /// Uitnodigings-/reset-tokens ooit voor deze gebruiker aangemaakt (zie PasswordSetupToken).
  passwordSetupTokens PasswordSetupToken[]

  /// Werkbon-ondertekeningen die deze gebruiker (typisch de technieker zelf,
  /// via zijn eigen ingelogde sessie) aan de klant heeft gevraagd (Phase 6/7 —
  /// zie WorkOrderSignature hieronder).
  requestedWorkOrderSignatures WorkOrderSignature[]

  /// Facturatiebatches die deze admin ooit "voorbereid voor facturatie" heeft (Phase 10).
  createdInvoiceBatches InvoiceBatch[]

  /// Phase 12, deel E — personeelsuitbetalingsbatches die deze admin ooit heeft aangemaakt.
  createdPayrollBatches PayrollBatch[]

  /// Phase 12, deel B — weekgoedkeuringen die deze gebruiker ooit heeft aangevraagd (de uitvoerder die "Week aftekenen" koos).
  requestedWeeklyApprovals WeeklyApproval[]

  /// Op vraag (3/9/2026) — zie AuditLog hieronder.
  auditLogs AuditLog[]

  @@index([role])
  @@map("user")
}

/// Eén token voor zowel "wachtwoord instellen bij uitnodiging" (nieuwe
/// gebruiker, passwordHash nog null) als "wachtwoord vergeten" (bestaande
/// gebruiker) — functioneel identiek: een geldig, eenmalig token geeft het
/// recht om een nieuw wachtwoord te zetten voor de gekoppelde gebruiker. Zie
/// PasswordResetService (apps/api/src/modules/auth/password-reset.service.ts).
///
/// Zelfde patroon als Session hierboven: het token zelf is de primary key
/// (hoge entropie, random gegenereerd), niet gehasht opgeslagen — analoog aan
/// hoe Session.id ook rechtstreeks als cookiewaarde gebruikt wordt.
model PasswordSetupToken {
  id        String    @id @db.VarChar(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_setup_token")
}

model Employee {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String  @unique @map("user_id") @db.Uuid
  displayName String  @map("display_name")
  phone       String?

  /// Facturatie: standaard uurtarief van deze medewerker (in eurocent), in te
  /// stellen door een admin bij "Medewerkers" (zie user.routes.ts). Vervangt
  /// sinds deze uitbreiding het per-klant-tarief (Customer.hourlyRateCents,
  /// zie de toelichting daar) als bron voor factuurregels: een conceptfactuur
  /// wordt geprijsd op basis van wélke medewerker de uren registreerde, niet
  /// meer op basis van de klant. Null tot een admin dit invult — ontbreekt dit
  /// nog voor een medewerker die op een factuurbatch voorkomt, dan kan de admin
  /// het tarief eenmalig voor die factuur invullen op de Facturatie-pagina
  /// (zie InvoiceBatchEmployeeRate hieronder) zonder de instellingenpagina te
  /// hoeven verlaten.
  defaultHourlyRateCents Int? @map("default_hourly_rate_cents")

  /// Fase 12-herziening (op vraag na de eerste versie van deel A/E):
  /// `defaultHourlyRateCents` hierboven is de VERKOOPPRIJS (facturatie aan de
  /// klant, ongewijzigd qua betekenis/gebruik). Dit hier is de KOSTPRIJS —
  /// wat effectief aan de medewerker/onderaannemer uitbetaald wordt
  /// (PayrollService). Dit zijn bewust twee aparte bedragen (Swatts marge zit
  /// in het verschil); de toeslagpercentages (nu op Project, zie
  /// Project.overtimeRatePercent e.a.) worden wél identiek op beide tarieven
  /// toegepast, enkel de basis verschilt. `null` tot een admin dit invult —
  /// PayrollService kan dan nog geen personeelsuitbetaling voor deze
  /// medewerker afsluiten (zelfde "nog geen tarief"-patroon als hierboven).
  payrollRateCents Int? @map("payroll_rate_cents")

  /// Werknemer vs. Onderaannemer (zie EmploymentType hierboven) — bepaalt
  /// welk soort document deze persoon krijgt bij de maandelijkse
  /// uren-/loonexport. Default EMPLOYEE: bestaande medewerkers veranderen
  /// niet van gedrag na deze migratie.
  employmentType EmploymentType @default(EMPLOYEE) @map("employment_type")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Welke Teamleader-projecten deze werknemer mag selecteren om uren op te boeken
  /// (Phase 3 — zie ProjectAssignment hieronder en Stap 4 van het fundamentendocument).
  projectAssignments ProjectAssignment[]

  /// Eigen tijdsregistraties (Phase 4 — zie TimeEntry hieronder).
  timeEntries TimeEntry[]

  /// Werkbonnen die deze werknemer heeft aangemaakt (Phase 5 — zie WorkOrder hieronder).
  createdWorkOrders WorkOrder[]

  /// Foto's die deze werknemer aan een werkbon heeft toegevoegd (Phase 6 — zie WorkOrderPhoto hieronder).
  uploadedWorkOrderPhotos WorkOrderPhoto[]

  /// Eenmalige tariefoverrides per factuurbatch, enkel gebruikt wanneer
  /// `defaultHourlyRateCents` hierboven nog niet is ingevuld (zie
  /// InvoiceBatchEmployeeRate hieronder).
  invoiceBatchRateOverrides InvoiceBatchEmployeeRate[]

  /// Phase 12, deel E — personeelsuitbetalingen van deze medewerker.
  payrollBatches PayrollBatch[]

  @@map("employee")
}

/// Server-side sessieopslag (niet in het oorspronkelijke Stap 4-datamodel, maar
/// noodzakelijk voor de gekozen auth-aanpak: httpOnly cookie + server-side sessie
/// i.p.v. een JWT in de browser, zodat een sessie op elk moment serverzijdig
/// ingetrokken kan worden — bv. bij het deactiveren van een gebruiker).
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// Singleton-rij: er hoort maar één Teamleader-koppeling te zijn voor de hele
/// organisatie. Afgedwongen door de service-laag met een vast, welbekend ID
/// (TEAMLEADER_CONNECTION_SINGLETON_ID in teamleader-auth.service.ts) i.p.v.
/// een DB-constraint — analoog aan de company_settings-singleton uit het
/// oorspronkelijke Stap 4-datamodel.
///
/// Bewuste vereenvoudiging t.o.v. die Stap 4-schets: `client_id`/`client_secret`
/// worden hier NIET bewaard. Er is maar één Teamleader-marketplace-app-registratie
/// voor de hele levensduur van de app, dus die horen als environment variable thuis
/// (TEAMLEADER_CLIENT_ID/TEAMLEADER_CLIENT_SECRET — zie config/env.ts), niet als
/// muteerbare databasedata: één minder geheim dat via een databackup zou kunnen lekken.
model TeamleaderConnection {
  id     String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status TeamleaderConnectionStatus @default(DISCONNECTED)

  /// AES-256-GCM-versleuteld (iv || authTag || ciphertext) — zie token-crypto.service.ts.
  /// Nooit de tokens in platte tekst opslaan (sectie 3 en 25 van de projectbrief).
  accessTokenEncrypted  Bytes? @map("access_token_encrypted")
  refreshTokenEncrypted Bytes? @map("refresh_token_encrypted")

  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz

  /// Gedetecteerd bij de eerste project-sync-poging (zie ProjectSyncService,
  /// Phase 3) via `accounts.projects-v2-status`, en daarna hier gecached zodat
  /// niet elke sync-run opnieuw diezelfde detectie-call moet doen. Null =
  /// nog niet gedetecteerd (bv. meteen na een nieuwe koppeling).
  projectsModule TeamleaderProjectsModule? @map("projects_module")

  /// Mensentaal-samenvatting van de laatste fout (sectie 27) — null zolang alles goed gaat.
  lastError String? @map("last_error")

  /// Phase 9 — Teamleader-user-ID gebruikt als `responsible_user_id` wanneer
  /// TimeTrackingSyncService automatisch een nieuwe milestone aanmaakt voor
  /// een project zonder gekozen/bestaande milestone (zie MilestoneSyncService).
  /// Null = automatische aanmaak is niet geconfigureerd; de sync geeft dan een
  /// duidelijke, actiegerichte foutmelding i.p.v. te gokken wie
  /// verantwoordelijk moet zijn. Ingesteld door een admin op het
  /// Teamleader-instellingenscherm (dropdown, gevuld via een live
  /// `users.list`-aanroep — zie GET /admin/teamleader/users).
  defaultMilestoneResponsibleTeamleaderUserId String? @map("default_milestone_responsible_teamleader_user_id")

  /// Phase 10b — vaste keuzes voor `invoices.draft` (department_id/tax_rate_id/
  /// payment_term zijn allemaal verplicht bij dat endpoint, maar veranderen
  /// zelden — zie claude/phase10-facturatie-onderzoek.md). Ingesteld door een
  /// admin op het Teamleader-instellingenscherm (dropdowns, gevuld via live
  /// departments.list/taxRates.list/paymentTerms.list-opvragingen — zie
  /// GET /admin/teamleader/invoice-options). Alle vier null tot een admin dit
  /// instelt; zonder deze waarden geeft TeamleaderInvoiceService een
  /// actiegerichte foutmelding i.p.v. te gokken.
  invoiceDepartmentId    String? @map("invoice_department_id")
  invoiceTaxRateId       String? @map("invoice_tax_rate_id")
  /// Teamleader's `payment_term.type`-enum (bv. "CASH", "END_OF_MONTH",
  /// "AFTER_INVOICE_DATE") — als losse tekst opgeslagen i.p.v. een eigen enum,
  /// want dit is Teamleader's eigen waardenverzameling, niet de onze (zelfde
  /// reden als Project.status elders in dit schema puur informatief blijft).
  invoicePaymentTermType String? @map("invoice_payment_term_type")
  invoicePaymentTermDays Int?    @map("invoice_payment_term_days")

  connectedByUserId String?   @map("connected_by_user_id") @db.Uuid
  connectedAt       DateTime? @map("connected_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  connectedByUser User? @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)

  @@index([connectedByUserId])
  @@map("teamleader_connection")
}

// ============================================================
// Phase 3 (slice) — read-only Teamleader-projectcache + koppeling
// werknemer↔project. Zie ProjectSyncService/CustomerSyncService
// (apps/api/src/modules/teamleader/) en Stap 4 van het fundamentendocument.
//
// Bewuste vereenvoudigingen t.o.v. de oorspronkelijke Stap 4-schets:
// - `Customer.address`/`Project.address` zijn één samengestelde tekstkolom
//   (opgebouwd uit Teamleader's AddressResponse: line_1 + postcode/stad),
//   geen aparte kolommen — enkel nodig als leesbare weergave op de
//   projectkaart, niet als gestructureerde data.
// - `Project.address` is een kopie van `Customer.address` op syncmoment
//   (denormalisatie voor de projectkaart-UI, sectie 5). Een adreswijziging
//   bij de klant in Teamleader komt pas door bij de eerstvolgende sync.
// - Een Teamleader-project zonder gekoppelde klant wordt NIET gesynchroniseerd
//   (zowel de legacy als de projects-v2 API staan dat toe — bv. een intern
//   project) — dit datamodel vereist net als de oorspronkelijke Stap 4-schets
//   een klant per project (WorkOrder.customerId leunt hierop). Zie
//   ProjectSyncService voor de exacte telling van overgeslagen projecten.
// - Een projects-v2-project kan in theorie meerdere klanten hebben
//   (`customers`-array); wij bewaren enkel de eerste — te herzien zodra dit
//   in de praktijk voorkomt bij een echt Teamleader-account.
// ============================================================

model Customer {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamleaderId   String  @unique @map("teamleader_id")
  teamleaderType String  @map("teamleader_type") // 'contact' | 'company'
  name           String
  /// Werknemer vs. Onderaannemer-uitbreiding (3/9/2026): "PDF via een knop
  /// naar de klant sturen". Opgehaald via het `emails`-veld van Teamleader
  /// contacts.list/companies.list (array van {type, email} — geverifieerd
  /// via een erkende SDK-referentie, zie project-sync.service.ts). `null`
  /// zolang niet gesynchroniseerd of geen e-mailadres bij Teamleader gekend.
  email          String?
  address        String?
  vatNumber      String? @map("vat_number")
  isArchivedInTl Boolean @default(false) @map("is_archived_in_tl")

  /// Phase 10b — uurtarief voor factuurregels (in eurocent, om afrondingsfouten
  /// met floats te vermijden). Steven bevestigde dat elke klant zijn eigen
  /// uurtarief heeft, afgesproken via een offerte — dus GEEN vast bedrijfsbreed
  /// tarief en GEEN tarief per werk-type (zie claude/phase10-facturatie-onderzoek.md).
  /// Null tot een admin dit invult op de Facturatie-pagina; zonder waarde kan er
  /// voor deze klant geen Teamleader-conceptfactuur aangemaakt worden
  /// (zie TeamleaderInvoiceService.createDraftInvoice).
  hourlyRateCents Int? @map("hourly_rate_cents")

  lastSyncedAt DateTime @map("last_synced_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  projects Project[]

  /// Facturatiebatches voor deze klant (Phase 10 — zie InvoiceBatch hieronder).
  invoiceBatches InvoiceBatch[]

  @@map("customer")
}

model Project {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamleaderId      String                   @unique @map("teamleader_id")
  teamleaderModule  TeamleaderProjectsModule @map("teamleader_module")
  customerId        String                   @map("customer_id") @db.Uuid
  /// `reference` (legacy, bv. "PRO-2") of `project_key` (projects-v2, sequentieel nummer) als tekst.
  projectNumber     String?                  @map("project_number")
  name              String
  description       String?
  /// Kopie van customer.address op syncmoment — zie toelichting bovenaan dit blok.
  address           String?
  /// Ruwe Teamleader-statuswaarde (legacy: active/on_hold/done/cancelled; projects-v2: open/closed) — puur informatief.
  status            String?
  isArchivedInTl    Boolean                  @default(false) @map("is_archived_in_tl")
  /// Phase 12, deel C — sectie 3 van de projectbrief: wanneer false, blijft
  /// tijdregistratie + PDF wél naar Teamleader synchroniseren (nacalculatie),
  /// maar de werkbon stroomt nooit door naar het lokale Facturatie-overzicht
  /// (zie InvoiceBatchService.listInvoiceable()). Instelbaar door ADMIN op het
  /// backoffice-projectscherm.
  invoicingEnabled  Boolean                  @default(true) @map("invoicing_enabled")
  /// Fase 12-herziening: "Overuren boven 8u/dag" (DAILY, vaste drempel) of
  /// "Overuren boven [x]u/week" (WEEKLY, drempel in
  /// overtimeWeeklyThresholdHours — vrij instelbaar getal, bv. 39 of 40).
  /// Sinds deze herziening geldt de volledige toeslagregeling (dit +
  /// onderstaande velden) UNIFORM voor iedereen die op dit project werkt —
  /// "de medewerker/onderaannemer wordt uitbetaald volgens de afspraken met
  /// de klant" was de expliciete reden om dit van Employee/ProjectAssignment
  /// naar hier te verhuizen (geen per-medewerker-uitzondering meer nodig).
  overtimeThresholdType        OvertimeThresholdType @default(DAILY) @map("overtime_threshold_type")
  overtimeWeeklyThresholdHours Decimal?              @map("overtime_weekly_threshold_hours") @db.Decimal(4, 2)
  /// Overuren staat onafhankelijk naast ploegenwerk/nachtwerk (die elkaar
  /// uitsluiten via premiumType, radiovakjes in de UI).
  overtimeApplies Boolean     @default(false) @map("overtime_applies")
  premiumType     PremiumType @default(NONE) @map("premium_type")
  /// Percentages van het uurtarief — toegepast op zowel Employee.defaultHourlyRateCents
  /// (facturatie) als Employee.payrollRateCents (uitbetaling): zelfde percentage,
  /// andere basis. Admin-only zichtbaar (business rule 11).
  overtimeRatePercent  Int @default(150) @map("overtime_rate_percent")
  shiftWorkRatePercent Int @default(120) @map("shift_work_rate_percent")
  nightWorkRatePercent Int @default(150) @map("night_work_rate_percent")
  /// Phase 12, deel B (sectie 2) — "Ondertekening per werkbon" (default) of
  /// "Ondertekening per week" (zie WeeklyApproval hieronder).
  signingMode SigningMode @default(PER_WORK_ORDER) @map("signing_mode")

  /// Phase 12, deel D (sectie 5) — rijafstand ÉÉN richting (in meter) tussen
  /// het Swatt-adres (CompanySettings.addressLine) en dit projectadres,
  /// berekend via OpenRouteService (zie DistanceService). `null` zolang nog
  /// niet berekend (bv. adres nog onbekend, of de km-vergoeding staat niet
  /// aan / OPENROUTESERVICE_API_KEY ontbreekt) — ververst bij elke
  /// projectsync waarbij het adres effectief wijzigt (ProjectSyncService),
  /// niet bij elke sync opnieuw (business rule/sectie 28: geen onnodige
  /// externe API-calls).
  kmDistanceOneWayMeters Int? @map("km_distance_one_way_meters")

  weeklyApprovals WeeklyApproval[]

  lastSyncedAt DateTime @map("last_synced_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// Phase 9 — welke Teamleader-milestone van dit (legacy) project de
  /// werkbon-uren van dit project ontvangt (zie MilestoneSyncService). Null
  /// tot een admin/supervisor er één kiest, of tot de eerste sync er zelf één
  /// aanmaakt (afhankelijk van TeamleaderConnection.defaultMilestoneResponsibleTeamleaderUserId).
  /// Een aparte, expliciet genoemde relatie (i.p.v. de standaard/impliciete
  /// Milestone.projectId-relatie hieronder) omdat een project meerdere
  /// milestones kan hebben (via sync), maar hoogstens één ervan "de" milestone
  /// voor werkbon-uren is.
  timeTrackingMilestoneId String?    @map("time_tracking_milestone_id") @db.Uuid
  timeTrackingMilestone   Milestone? @relation("ProjectTimeTrackingMilestone", fields: [timeTrackingMilestoneId], references: [id], onDelete: SetNull)

  customer    Customer             @relation(fields: [customerId], references: [id])
  assignments ProjectAssignment[]
  /// Tijdsregistraties op dit project (Phase 4 — zie TimeEntry hieronder).
  timeEntries TimeEntry[]
  /// Werkbonnen op dit project (Phase 5 — zie WorkOrder hieronder).
  workOrders  WorkOrder[]
  /// Alle gesynchroniseerde milestones van dit project (Phase 9 — zie Milestone hieronder).
  milestones  Milestone[]

  @@index([customerId])
  @@index([isArchivedInTl])
  @@index([timeTrackingMilestoneId])
  @@map("project")
}

// ============================================================
// Phase 9 — Teamleader-sync: tijdregistratie + PDF-upload (secties 13-15/23
// van de projectbrief). Zie apps/api/src/modules/teamleader/milestone-sync.service.ts,
// time-tracking-sync.service.ts, file-sync.service.ts en apps/api/src/modules/sync/.
//
// BELANGRIJKE, tegen de officiële Teamleader-API-documentatie geverifieerde
// beperking (github.com/teamleadercrm/api/blob/master/apiary.apib, sectie
// "Time Tracking"): `timeTracking.add` accepteert als `subject.type` enkel
// company/contact/event/todo/milestone/ticket — GEEN `project` (sinds de
// wijziging van 2019-07-03: "We won't accept `project` as a subject anymore
// [...] time tracking always needs to be coupled to a milestone") en GEEN
// `nextgenProject`/task. Swatt/Ecofinity's Teamleader-account gebruikt de
// LEGACY-projectenmodule (bevestigd door Steven) — vandaar dat gesynchroniseerde
// uren via een `milestone` moeten lopen, niet rechtstreeks via het project.
// Voor een `projects-v2`-account biedt de huidige publieke API géén
// gedocumenteerde manier om tijd aan het project/een taak te koppelen; die
// tak is bewust NIET geïmplementeerd (zie TimeTrackingSyncService — geeft een
// duidelijke, actiegerichte fout i.p.v. te gokken).
// ============================================================

/// Lokale cache van Teamleader-milestones (enkel relevant voor legacy-projecten
/// — projects-v2 heeft geen milestone-concept). Gevuld door MilestoneSyncService
/// via `milestones.list` (filter op `project_id`), of door onszelf aangemaakt
/// via `milestones.create` wanneer een project nog geen (gekozen) milestone heeft.
model Milestone {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamleaderId   String   @unique @map("teamleader_id")
  projectId      String   @map("project_id") @db.Uuid
  name           String
  /// Ruwe Teamleader-statuswaarde ('open'/'closed') — puur informatief, zelfde patroon als Project.status.
  status         String
  dueOn          DateTime? @map("due_on") @db.Date
  isArchivedInTl Boolean  @default(false) @map("is_archived_in_tl")

  lastSyncedAt DateTime @map("last_synced_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Projecten die deze milestone als hun "werkbon-uren"-milestone gekozen hebben
  /// (normaliter hoogstens één — de eigen `project` hierboven — maar Prisma vereist
  /// deze inverse zijde voor de expliciet genoemde relatie op Project).
  defaultForProjects Project[] @relation("ProjectTimeTrackingMilestone")

  @@index([projectId])
  @@map("milestone")
}

model ProjectAssignment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  assignedByUserId String  @map("assigned_by_user_id") @db.Uuid
  assignedAt      DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedByUser User     @relation(fields: [assignedByUserId], references: [id])

  @@unique([projectId, employeeId])
  @@index([employeeId])
  @@map("project_assignment")
}

// ============================================================
// Phase 4 — timer ("START WERK"). Zie modules/time-entries/ en Stap 6/9 van
// het fundamentendocument (secties 6 en 24 van de projectbrief).
// ============================================================

/// Eén actieve (RUNNING/PAUSED) tijdsregistratie per werknemer — business rule
/// 1 (sectie 24). Naast de service-laag-check dwingt de partiële unieke index
/// `time_entry_one_active_per_employee` (zie migratie) dit ook op
/// databankniveau af, als backstop tegen een race condition tussen twee
/// gelijktijdige "start"-aanvragen.
///
/// `pausedSeconds` is de som van alle AFGERONDE pauze-intervallen; de nog
/// lopende pauze (indien status = PAUSED, via `currentPauseStartedAt`) wordt
/// pas bij hervatten of stoppen opgeteld — zie TimeEntryService voor de
/// berekening van de netto gewerkte tijd.
model TimeEntry {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String           @map("employee_id") @db.Uuid
  projectId  String           @map("project_id") @db.Uuid
  status     TimeEntryStatus  @default(RUNNING)

  startedAt DateTime  @map("started_at") @db.Timestamptz
  endedAt   DateTime? @map("ended_at") @db.Timestamptz

  pausedSeconds         Int       @default(0) @map("paused_seconds")
  currentPauseStartedAt DateTime? @map("current_pause_started_at") @db.Timestamptz

  /// Vrij tekstveld "uitgevoerde werkzaamheden" (sectie 6/7) — optioneel, meestal
  /// pas ingevuld bij het stoppen van de timer.
  description String?

  /// Sectie 6: "manueel tijd toevoegen indien toegestaan". `true` wanneer deze
  /// registratie rechtstreeks als STOPPED is aangemaakt via
  /// TimeEntryService.createManual() (vaste start-/eindtijd door de werknemer
  /// ingegeven) in plaats van via de START/PAUZE/STOP-timerflow. Zuiver
  /// informatief (badge in de UI, filter voor supervisors) — beïnvloedt geen
  /// enkele business rule: een manuele registratie doorloopt daarna exact
  /// dezelfde werkbon-/Teamleader-sync-flow als een gestopte timer.
  isManual Boolean @default(false) @map("is_manual")

  /// Werknemer vs. Onderaannemer — uren-export (op vraag, 3/9/2026): "eens de
  /// export is gebeurd zou ervoor gezorgd moeten worden dat die werkbonnen als
  /// geëxporteerd gemarkeerd staan en niet meer meegeteld worden in een
  /// volgende export, om dubbele facturatie tegen te gaan". Analoog aan hoe
  /// InvoiceBatch/PayrollBatch een tijdregistratie "opgebruikt" markeren
  /// (business rule 5/12), maar hier bewust een simpele timestamp i.p.v. een
  /// volwaardig batch-model — de uren-export zelf genereert geen document dat
  /// nadien nog geraadpleegd moet worden zoals een factuur/uitbetaling dat
  /// wel doet. `null` = nog niet geëxporteerd. Gezet via een expliciete
  /// "Markeer als geëxporteerd"-actie (HoursExportService.markExported()),
  /// nooit automatisch bij het enkel downloaden van het document zelf (een
  /// GET-download mag geen blijvend neveneffect hebben — bv. een browser die
  /// per ongeluk tweemaal ophaalt).
  hoursExportedAt DateTime? @map("hours_exported_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  /// Phase 9 — sync naar Teamleader (`timeTracking.add`, sectie 14). Business
  /// rule 5: "Iedere tijdregistratie mag maar één keer naar Teamleader
  /// gestuurd worden" — afgedwongen doordat TimeTrackingSyncService een
  /// entry met syncStatus SYNCED altijd overslaat (nooit opnieuw post), plus
  /// de unieke `teamleaderTimeTrackingId` hieronder als backstop tegen een
  /// race condition tussen twee gelijktijdige sync-pogingen.
  syncStatus               TimeEntrySyncStatus @default(NOT_SYNCED) @map("sync_status")
  teamleaderTimeTrackingId String?             @unique @map("teamleader_time_tracking_id")
  syncedAt                 DateTime?           @map("synced_at") @db.Timestamptz
  /// SHA-256 van de canonieke payload die naar `timeTracking.add` gestuurd
  /// werd/wordt — audit/diagnose-signaal (sectie 14: "payload hash"), niet de
  /// idempotentiegarantie zelf (die zit in syncStatus/teamleaderTimeTrackingId
  /// hierboven — een immutable, ondertekende werkbon kan sowieso nooit een
  /// gewijzigde payload opnieuw genereren).
  syncPayloadHash          String?             @map("sync_payload_hash")
  /// Mensentaal-fout (sectie 27) van de laatste mislukte synchronisatiepoging — null zolang alles goed gaat of nog niet geprobeerd is.
  syncError                String?             @map("sync_error")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)

  /// Gezet zodra deze registratie in een werkbon is opgenomen (Phase 5) — een
  /// gestopte tijdsregistratie hoort bij hoogstens één werkbon, zie
  /// WorkOrderTimeEntry.timeEntryId (unique) hieronder.
  workOrderLink WorkOrderTimeEntry?

  /// Phase 12, deel E — gezet zodra deze registratie in een
  /// personeelsuitbetaling is opgenomen (business rule 12).
  payrollLine PayrollBatchLine?

  @@index([employeeId])
  @@index([projectId])
  @@index([syncStatus])
  @@map("time_entry")
}

// ============================================================
// Phase 5 — werkbonnen (basis). Zie modules/work-orders/ en secties 6-8, 20 en
// 24 van de projectbrief. Nog zonder foto's/handtekening/PDF/versionering
// (Phase 6/7/8) en zonder Teamleader-sync/facturatie (Phase 9/10) — die
// bouwen voort op deze basis zonder de kern hieronder te moeten wijzigen.
// ============================================================

/// Eén teller per jaar voor het volgnummer in werkbonnummers (bv.
/// "WB-2026-000123", sectie 7). Atomair opgehoogd door WorkOrderService — zie
/// de toelichting daar over hoe gelijktijdige aanmaak correct wordt afgehandeld.
model WorkOrderCounter {
  year       Int @id
  lastNumber Int @default(0) @map("last_number")

  @@map("work_order_counter")
}

/// Bundelt één of meer gestopte tijdsregistraties op hetzelfde project tot één
/// werkbon (zie WorkOrderTimeEntry). Een aparte koppeltabel i.p.v. een
/// rechtstreekse FK op TimeEntry omdat sectie 8 van de brief rekening houdt
/// met meerdere werknemers op dezelfde werf — ook al ondersteunt de UI in
/// Phase 5 nog enkel het simpele geval van één werknemer/één registratie.
model WorkOrder {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Bv. "WB-2026-000123" — zie WorkOrderCounter.
  workOrderNumber String          @unique @map("work_order_number")
  projectId       String          @map("project_id") @db.Uuid
  status          WorkOrderStatus @default(DRAFT)

  /// Vrij tekstveld "uitgevoerde werkzaamheden" (sectie 7) — apart bewaard
  /// (i.p.v. enkel via de gekoppelde TimeEntry's) zodat een werkbon met
  /// meerdere tijdsregistraties toch één samenhangende omschrijving heeft.
  description String?

  createdByEmployeeId String   @map("created_by_employee_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  project           Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdByEmployee Employee             @relation(fields: [createdByEmployeeId], references: [id])
  timeEntries       WorkOrderTimeEntry[]

  /// Foto's op deze werkbon (Phase 6 — zie WorkOrderPhoto hieronder).
  photos WorkOrderPhoto[]

  /// Handtekening van de klant — ten hoogste één per werkbon, en enkel gezet
  /// zodra status SIGNED is (Phase 7 — zie WorkOrderSignature hieronder).
  signature WorkOrderSignature?

  /// Phase 8 — PDF-generatie (secties 12/13/31), losgekoppeld van een
  /// eventuele latere Teamleader-upload (Phase 9). `pdfFileKey` is een
  /// StorageService-key (zie StoredFile), net als de foto's/handtekening
  /// hierboven — geen Prisma-FK, om dezelfde reden. `pdfError` is een
  /// mensentaal-boodschap (sectie 27), nooit een ruwe stacktrace.
  pdfStatus      WorkOrderPdfStatus @default(PDF_PENDING) @map("pdf_status")
  pdfFileKey     String?            @map("pdf_file_key")
  pdfFileName    String?            @map("pdf_file_name")
  pdfGeneratedAt DateTime?          @map("pdf_generated_at") @db.Timestamptz
  pdfError       String?            @map("pdf_error")

  /// Phase 9 — upload van de (Phase 8-)PDF naar het gekoppelde Teamleader-project
  /// (sectie 13), bewust losgekoppeld van pdfStatus hierboven (sectie 31).
  /// `teamleaderFileId` is business rule 6's "hoogstens één actieve
  /// Teamleader-file" — FileSyncService verwijdert (best-effort) het vorige
  /// bestand vóór een reupload (bv. na "PDF opnieuw genereren").
  teamleaderUploadStatus WorkOrderTeamleaderUploadStatus @default(TEAMLEADER_UPLOAD_PENDING) @map("teamleader_upload_status")
  teamleaderFileId       String?                         @map("teamleader_file_id")
  teamleaderUploadedAt   DateTime?                       @map("teamleader_uploaded_at") @db.Timestamptz
  teamleaderUploadError  String?                         @map("teamleader_upload_error")

  /// Phase 9 — achtergrond-syncjobs voor deze werkbon (TIME_ENTRIES + PDF_UPLOAD, zie SyncJob hieronder).
  syncJobs SyncJob[]

  /// Phase 10 — gezet zodra deze werkbon in een facturatiebatch is opgenomen
  /// (business rule 7: "een werkbon mag maar één keer gefactureerd worden").
  /// Ten hoogste één per werkbon, zie InvoiceBatchLine.workOrderId (unique).
  invoiceBatchLine InvoiceBatchLine?

  /// Phase 12, deel B — gezet zodra deze werkbon via een weekgoedkeuring is
  /// ondertekend (Project.signingMode = WEEKLY). `null` bij PER_WORK_ORDER-
  /// projecten, en ook nog `null` voor een WEEKLY-werkbon die nog niet
  /// ondertekend is (staat dan nog op status DRAFT, net als anders).
  weeklyApprovalId String?         @map("weekly_approval_id") @db.Uuid
  weeklyApproval   WeeklyApproval? @relation(fields: [weeklyApprovalId], references: [id])

  /// Phase 12, deel D (sectie 5) — bevroren bij afronding (net als de andere
  /// bedragen): kmDistanceOneWayMeters × 2 (heen-terug) × kmRateCents, op het
  /// moment dat de werkbon getekend wordt. Blijft daarna ongewijzigd, ook als
  /// het projectadres of het tarief later verandert (business rule 3-analoog
  /// — een bevroren bedrag verandert niet met terugwerkende kracht). `null`
  /// wanneer km-vergoeding niet actief was op het moment van ondertekenen
  /// (geen tarief ingesteld, of afstand nog onbekend).
  kmAmountCents Int? @map("km_amount_cents")

  /// Op vraag (3/9/2026): "PDF via een knop naar de klant sturen" — bewust
  /// een expliciete actie (geen automatische verzending, zie
  /// EmailErrors/de toelichting bij WorkOrderService.sendPdfToCustomer()).
  /// `null` = nog niet (of nooit) naar de klant gestuurd.
  customerEmailSentAt DateTime? @map("customer_email_sent_at") @db.Timestamptz

  /// Op vraag (3/9/2026): "automatische herinnering bij een 'vergeten'
  /// werkbon" — gezet zodra een herinneringsmail verstuurd is voor deze
  /// (nog steeds DRAFT) werkbon, zodat de achtergrondtaak dezelfde werkbon
  /// niet elke run opnieuw meldt. Wordt teruggezet op `null` zodra de
  /// werkbon alsnog ondertekend wordt (zie WorkOrderReminderService) — een
  /// hernieuwde DRAFT-periode (na heropenen, Phase 12 deel B) verdient een
  /// nieuwe herinnering.
  reminderSentAt DateTime? @map("reminder_sent_at") @db.Timestamptz

  @@index([projectId])
  @@index([status])
  @@index([pdfStatus])
  @@index([teamleaderUploadStatus])
  @@index([weeklyApprovalId])
  @@map("work_order")
}

 /// Phase 12, deel B (sectie 2 van de projectbrief): "werkbonnen per week laten
 /// tekenen door de klant". Eén rij per (project, kalenderweek) — de
 /// kalenderweek wordt bepaald op basis van `WorkOrder.createdAt` (er bestaat
 /// geen apart "werkdatum"-veld; een werkbon wordt aangemaakt op de dag zelf,
 /// zie WorkOrderService.create()).
 ///
 /// Bewust GEEN aparte weekoverzicht-PDF/Teamleader-upload-pijplijn (dat zou
 /// een volledig tweede document-template + upload-mechanisme betekenen naast
 /// het al bestaande per-werkbon-PDF-systeem, Phase 8/9) — bij het ondertekenen
 /// van de week krijgt élke onderliggende werkbon gewoon zijn eigen
 /// `WorkOrderSignature` (zelfde afbeelding/naam, individuele contentHash) en
 /// doorloopt zijn eigen bestaande PDF-generatie + Teamleader-upload
 /// ongewijzigd. Dit voldoet aan de functionele kern ("de klant tekent één
 /// keer voor de hele week") zonder de PDF/Teamleader-architectuur te
 /// verdubbelen — een gecombineerd weekoverzicht-PDF blijft een losstaande,
 /// additieve verbetering voor een latere fase.
model WeeklyApproval {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String               @map("project_id") @db.Uuid
  weekStartDate DateTime             @map("week_start_date") @db.Date
  weekEndDate   DateTime             @map("week_end_date") @db.Date
  status        WeeklyApprovalStatus @default(OPEN)

  signerName     String?   @map("signer_name")
  signerFunction String?   @map("signer_function")
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz
  ipAddress      String?   @map("ip_address")

  /// Wie de ondertekening heeft aangevraagd (sectie 10) — de uitvoerder die
  /// op zijn laatste registratie van de week "Week aftekenen" koos.
  requestedByUserId String? @map("requested_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedByUser User?      @relation(fields: [requestedByUserId], references: [id])
  workOrders      WorkOrder[]

  /// Eén weekgoedkeuring per project per week — sign()/reopen() werken altijd
  /// in-place op deze ene rij i.p.v. nieuwe rijen aan te maken, zodat deze
  /// constraint nooit een hertekening in de weg zit.
  @@unique([projectId, weekStartDate])
  @@map("weekly_approval")
}

/// Eén rij per (werkbon, syncsoort) — durable state, onafhankelijk van de
/// BullMQ/Redis-queue zelf (sectie 15/23): zelfs als Redis leeg raakt, blijft
/// hier zichtbaar wélke werkbonnen nog moeten (her)synchroniseren, en kan een
/// admin "Opnieuw synchroniseren" gewoon een nieuwe queue-job aanmaken die
/// deze rij hergebruikt (business rule 9 — externe-infrastructuurstoring mag
/// nooit lokale data laten verloren gaan).
model SyncJob {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderId String        @map("work_order_id") @db.Uuid
  type        SyncJobType
  status      SyncJobStatus @default(PENDING)
  attempts    Int           @default(0)

  lastError       String?   @map("last_error")
  lastAttemptedAt DateTime? @map("last_attempted_at") @db.Timestamptz
  completedAt     DateTime? @map("completed_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  logs      SyncLog[]

  /// Eén job per (werkbon, syncsoort) — een "opnieuw synchroniseren"-aanvraag
  /// werkt de bestaande rij bij (attempts++) i.p.v. een duplicaat aan te maken.
  @@unique([workOrderId, type])
  @@index([status])
  @@map("sync_job")
}

/// Append-only audittrail van elke sync-*poging* (sectie 23/26 — "Teamleader
/// sync" / "Teamleader sync mislukt" moeten auditbaar zijn). `detail` is de
/// ruwe/technische foutinformatie (sectie 27: "Administrator kan detail
/// openen voor technische foutinformatie"); `message` is altijd mensentaal.
model SyncLog {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  syncJobId String        @map("sync_job_id") @db.Uuid
  attempt   Int
  status    SyncLogStatus
  message   String
  detail    String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  syncJob SyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId])
  @@map("sync_log")
}

/// Koppeltabel werkbon ↔ tijdsregistratie. `timeEntryId` is uniek: elke
/// tijdsregistratie hoort bij hoogstens één werkbon.
model WorkOrderTimeEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderId String   @map("work_order_id") @db.Uuid
  timeEntryId String   @unique @map("time_entry_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  timeEntry TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Restrict)

  @@index([workOrderId])
  @@map("work_order_time_entry")
}

// ============================================================
// Phase 6/7 — foto's + verplichte klanthandtekening. Zie
// modules/storage/ en modules/work-orders/, en secties 9-11 van de
// projectbrief.
//
// Opslagstrategie (bewuste keuze op vraag van Steven — "snel starten: opslag
// in de database"): foto's en de handtekeningafbeelding worden als bytea in
// Postgres bewaard via StoredFile hieronder, achter een StorageService-
// abstractielaag (zie storage.service.ts). WorkOrderPhoto/WorkOrderSignature
// verwijzen daarom bewust NIET via een Prisma-FK naar StoredFile — de
// "storage key" die zij bewaren (optimizedFileKey/thumbnailFileKey/
// signatureFileKey) is voor hen een ondoorzichtige string (vandaag een
// StoredFile.id, later evt. een S3-object-key). Dat laat toe om later over
// te schakelen naar echte S3-compatibele opslag zonder deze twee modellen —
// of de code die ze aanroept — te moeten wijzigen (sectie 2 van de brief:
// "bouw een abstraction/service layer zodat de implementatie later
// aangepast kan worden").
// ============================================================

/// Generieke binaire opslag (bytea) — zie DatabaseStorageService. Bewust
/// zonder relaties: elke tabel die hiernaar verwijst doet dat via een
/// ondoorzichtige key-string, nooit via een Prisma-relatie (zie hierboven).
model StoredFile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mimeType  String   @map("mime_type")
  data      Bytes
  sizeBytes Int      @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("stored_file")
}

/// Eén foto op een werkbon (sectie 9). `optimizedFileKey`/`thumbnailFileKey`
/// zijn StorageService-keys (zie StoredFile hierboven) — geen ruwe bytes hier.
/// Categorie is optioneel (sectie 9: "Categorie mag optioneel zijn").
model WorkOrderPhoto {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderId String                  @map("work_order_id") @db.Uuid
  category    WorkOrderPhotoCategory?
  description String?

  optimizedFileKey String @map("optimized_file_key")
  thumbnailFileKey String @map("thumbnail_file_key")

  uploadedByEmployeeId String   @map("uploaded_by_employee_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  workOrder          WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  uploadedByEmployee Employee  @relation(fields: [uploadedByEmployeeId], references: [id])

  @@index([workOrderId])
  @@map("work_order_photo")
}

/// Digitale handtekening van de eindklant (sectie 10) — ten hoogste één per
/// werkbon (`workOrderId` uniek). Zodra deze rij bestaat, is de werkbon
/// SIGNED en dus immutable (sectie 11 — business rule 3); een correctie
/// vereist expliciet heropenen, wat een latere fase is (nog niet gebouwd).
model WorkOrderSignature {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderId    String  @unique @map("work_order_id") @db.Uuid
  signerName     String  @map("signer_name")
  signerFunction String? @map("signer_function")

  /// StorageService-key naar de PNG van het handtekening-canvas (zie StoredFile).
  signatureFileKey String @map("signature_file_key")

  signedAt  DateTime @map("signed_at") @db.Timestamptz
  ipAddress String?  @map("ip_address")

  /// SHA-256 van een canonieke JSON-snapshot (omschrijving + gesorteerde
  /// tijdsregistratie- en foto-ID's) op het moment van ondertekenen — een
  /// lichtgewicht tamper-evidence-signaal, GEEN volledige WorkOrderVersion-
  /// audittrail (sectie 11 van de brief blijft daarmee deels een latere fase).
  contentHash String @map("content_hash")

  requestedByUserId String   @map("requested_by_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  workOrder        WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  requestedByUser  User      @relation(fields: [requestedByUserId], references: [id])

  @@map("work_order_signature")
}

// ============================================================
// Phase 8 — bedrijfsgegevens voor de werkbon-PDF-header (secties 7/12).
// ============================================================

/// Singleton-rij, zelfde patroon als TeamleaderConnection hierboven: een
/// vast, welbekend ID (COMPANY_SETTINGS_SINGLETON_ID in
/// company-settings.service.ts), lazy aangemaakt met verstandige
/// placeholderwaarden bij de eerste opvraging — geen aparte seed-migratie
/// nodig. Vandaag enkel gelezen door WorkOrderPdfService; een
/// admin-instellingenscherm om dit aan te passen is een logische, kleine
/// vervolgstap (nog niet gebouwd deze ronde).
model CompanySettings {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  companyName  String  @map("company_name")
  addressLine  String? @map("address_line")
  vatNumber    String? @map("vat_number")
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")

  /// StorageService-key van een geüpload bedrijfslogo (zie StoredFile) —
  /// optioneel; zonder logo valt de PDF-header terug op een gestileerd
  /// "UURIVO"-tekstlogo (zwarte achtergrond, gouden tekst), zie
  /// work-order-pdf-document.ts.
  logoFileKey String? @map("logo_file_key")

  /// Sectie 12: "Laat de exacte juridische formulering configureerbaar zijn."
  workOrderLegalText String @map("work_order_legal_text")

  /// Licentiebeperking (los van de app zelf gevraagd door Steven, niet uit
  /// de oorspronkelijke projectbrief): maximum aantal medewerkeraccounts dat
  /// binnen déze deployment aangemaakt mag worden, afhankelijk van het
  /// betaalplan van deze klant. `null` = geen limiet. Enkel afgedwongen bij
  /// het aanmaken van een nieuwe gebruiker (user.routes.ts) — bestaande
  /// medewerkers boven een later verlaagde limiet blijven gewoon werken,
  /// enkel geen NIEUWE meer aanmaken totdat er weer ruimte is (deactiveren of
  /// verwijderen telt mee, zie EmployeeService.countActive()).
  maxEmployees Int? @map("max_employees")

  /// Phase 12, deel D (sectie 5) — tarief per km (eurocent), admin-only
  /// zichtbaar (business rule 11). `null` = km-vergoeding niet actief.
  kmRateCents Int? @map("km_rate_cents")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("company_settings")
}

// ============================================================
// Phase 10 — facturatie-overzicht (sectie 17/29 van de projectbrief). Zie
// modules/invoice-batches/ en claude/phase10-facturatie-onderzoek.md (project
// docs) voor het Teamleader-API-onderzoek dat hieraan voorafging.
//
// Phase 10b (25 augustus 2026) voegde de effectieve `invoices.draft`-koppeling
// toe (teamleaderInvoiceId/teamleaderSyncError/teamleaderSubmittedAt
// hieronder) — mogelijk zodra Steven het uurtarief-vraagstuk beantwoordde
// ("tarief per klant", zie Customer.hourlyRateCents) en de invoices/departments-
// scopes aanzette. Precies zoals hieronder al aangekondigd stond: het
// datamodel hoefde daarvoor niet te wijzigen, enkel deze drie velden toe te
// voegen.
// ============================================================

/// Eén "voorbereiden voor facturatie"-actie van een administrator: een
/// groepering van werkbonnen van dezelfde klant binnen dezelfde periode.
/// `periodLabel` is een vrije tekst (bv. "2026-08") i.p.v. een aparte
/// maand/jaar-kolom — simpeler voor filteren/groeperen dan een echte
/// periode-tabel, en de brief specificeert geen preciezere periode-indeling.
model InvoiceBatch {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String              @map("customer_id") @db.Uuid
  periodLabel String              @map("period_label")
  status      InvoiceBatchStatus  @default(DRAFT)

  /// Som van InvoiceBatchLine.invoiceableSeconds op aanmaakmoment — puur een
  /// snelle weergavewaarde (vermijdt een join/aggregatie bij elke lijst-render),
  /// de bron van waarheid blijft de som van de lines zelf.
  totalInvoiceableSeconds Int @default(0) @map("total_invoiceable_seconds")

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// Phase 10b — resultaat van de `invoices.draft`-aanroep (zie
  /// TeamleaderInvoiceService). `teamleaderInvoiceId` gezet ⇒ status is
  /// SUBMITTED_TO_TEAMLEADER (of INVOICED); `teamleaderSyncError` gezet ⇒ de
  /// laatste poging mislukte en de batch bleef bewust op DRAFT staan (business
  /// rule 9: een externe fout mag nooit lokale data laten verdwijnen) — een
  /// admin kan dan gewoon opnieuw op "Maak conceptfactuur in Teamleader"
  /// klikken. Nooit allebei tegelijk gezet.
  teamleaderInvoiceId   String?   @map("teamleader_invoice_id")
  teamleaderSyncError   String?   @map("teamleader_sync_error")
  teamleaderSubmittedAt DateTime? @map("teamleader_submitted_at") @db.Timestamptz

  customer       Customer            @relation(fields: [customerId], references: [id])
  createdByUser  User                @relation(fields: [createdByUserId], references: [id])
  lines          InvoiceBatchLine[]

  /// Eenmalige tariefoverrides voor medewerkers zonder `Employee.defaultHourlyRateCents`
  /// (zie InvoiceBatchEmployeeRate hieronder) — enkel gezet wanneer een admin dit
  /// bewust voor déze factuur heeft ingevuld op de Facturatie-pagina.
  employeeRates  InvoiceBatchEmployeeRate[]

  @@index([customerId])
  @@index([periodLabel])
  @@map("invoice_batch")
}

/// Koppelt één werkbon aan een InvoiceBatch. `workOrderId` is uniek — dat is
/// de databank-afgedwongen kant van business rule 7 ("een werkbon mag maar
/// één keer gefactureerd worden"): zolang deze rij bestaat, kan die werkbon
/// niet in een andere batch terechtkomen. Een per-ongeluk aangemaakte batch
/// wordt daarom volledig verwijderd (cascade) i.p.v. enkel "geannuleerd" —
/// er is nog niets extern (Teamleader) gebeurd, dus er valt niets terug te
/// draaien, enkel deze lokale koppeling weer vrij te geven.
model InvoiceBatchLine {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceBatchId     String   @map("invoice_batch_id") @db.Uuid
  workOrderId        String   @unique @map("work_order_id") @db.Uuid
  invoiceableSeconds Int      @map("invoiceable_seconds")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  invoiceBatch InvoiceBatch @relation(fields: [invoiceBatchId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  @@index([invoiceBatchId])
  @@map("invoice_batch_line")
}

/// Eénmalige uurtarief-override van één medewerker, voor één specifieke
/// InvoiceBatch — enkel nodig zolang `Employee.defaultHourlyRateCents` nog
/// niet is ingevuld voor die medewerker (zie de toelichting daar). Ingevuld
/// door een admin op de Facturatie-pagina, vlak vóór "Maak conceptfactuur in
/// Teamleader"; TeamleaderInvoiceService gebruikt deze waarde enkel als de
/// medewerker zelf geen standaardtarief heeft. Verwijderen van de batch
/// (cascade) ruimt deze overrides mee op — ze hebben buiten die ene batch
/// geen betekenis.
model InvoiceBatchEmployeeRate {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceBatchId  String   @map("invoice_batch_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  hourlyRateCents Int      @map("hourly_rate_cents")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  invoiceBatch InvoiceBatch @relation(fields: [invoiceBatchId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([invoiceBatchId, employeeId])
  @@map("invoice_batch_employee_rate")
}

 /// Phase 12, deel E (sectie "Personeelsuitbetaling"): maandoverzicht per
 /// medewerker met exact dezelfde rekenlogica als de klantfactuur
 /// (RateCalculationService, zie teamleader-invoice.service.ts) — maar bewust
 /// losgekoppeld van InvoiceBatch/Project.invoicingEnabled: een medewerker
 /// wordt uitbetaald voor ELKE gewerkte, ondertekende uur, ook op een
 /// nacalculatie-project (Phase 12, deel C) zonder klantfactuur.
model PayrollBatch {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String             @map("employee_id") @db.Uuid
  periodLabel String             @map("period_label")
  status      PayrollBatchStatus @default(DRAFT)

  /// Som van de lines op aanmaakmoment — puur weergavegemak (vermijdt een
  /// join/aggregatie bij elke lijst-render), zelfde patroon als
  /// InvoiceBatch.totalInvoiceableSeconds.
  totalAmountCents Int @default(0) @map("total_amount_cents")

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  closedAt        DateTime? @map("closed_at") @db.Timestamptz

  employee      Employee           @relation(fields: [employeeId], references: [id])
  createdByUser User               @relation(fields: [createdByUserId], references: [id])
  lines         PayrollBatchLine[]

  @@index([employeeId])
  @@index([periodLabel])
  @@map("payroll_batch")
}

 /// Eén rij per bronregistratie (TimeEntry) — `timeEntryId` is uniek over de
 /// hele tabel, business rule 12: "elke tijdregistratie mag maar één keer aan
 /// de medewerker uitbetaald worden" (zelfde databank-afgedwongen patroon als
 /// InvoiceBatchLine.workOrderId voor business rule 7). Bewust normale/overuren
 /// gescheiden op één rij per bronregistratie i.p.v. één generieke
 /// "categorie"-kolom: een enkele tijdregistratie kan zelf al deels normaal en
 /// deels overuren zijn (bv. een dag van 9u30 met een 8u-drempel), en dit
 /// behoudt toch de "één rij per bron"-garantie die business rule 12 vereist.
model PayrollBatchLine {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payrollBatchId String      @map("payroll_batch_id") @db.Uuid
  timeEntryId    String      @unique @map("time_entry_id") @db.Uuid
  normalHours    Decimal     @map("normal_hours") @db.Decimal(6, 2)
  overtimeHours  Decimal     @map("overtime_hours") @db.Decimal(6, 2)
  /// Overgenomen van de ProjectAssignment op het moment van aanmaak — bevroren,
  /// net als de uren/het bedrag (wijzigt de koppeling nadien, dan blijft deze
  /// al uitbetaalde regel ongewijzigd).
  premiumType PremiumType @map("premium_type")
  amountCents Int         @map("amount_cents")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  payrollBatch PayrollBatch @relation(fields: [payrollBatchId], references: [id], onDelete: Cascade)
  timeEntry    TimeEntry    @relation(fields: [timeEntryId], references: [id], onDelete: Restrict)

  @@index([payrollBatchId])
  @@map("payroll_batch_line")
}

/// Op vraag (3/9/2026): "auditlog-scherm, om bij een geschil te zien wie iets
/// wanneer gewijzigd heeft" — sectie 23/26 uit de oorspronkelijke projectbrief
/// (nooit als apart model gebouwd; tot nu toe enkel impliciet via losse
/// timestamps op verschillende tabellen). Bewust een generiek, lichtgewicht
/// model (geen aparte tabel per entiteitstype) — `entityType`/`entityId` zijn
/// vrije tekst, geen FK, want een AuditLog-rij moet blijven bestaan ook als de
/// onderliggende entiteit later verwijderd wordt (bv. een verwijderde
/// PayrollBatch). `metadata` is vrije JSON voor actie-specifieke details (bv.
/// oude/nieuwe waarde) — bewust geen apart `oldValue`/`newValue`-kolommenpaar,
/// dat zou voor sommige acties (bv. "werkbon ondertekend") geen betekenis
/// hebben.
///
/// Fase 1 van dit model instrumenteert bewust enkel de hoogste-impact
/// financiële/status-wijzigingen (ondertekenen, heropenen, personeels-/
/// facturatiebatches, als-geëxporteerd markeren, gebruikersbeheer) — niet elke
/// actie uit sectie 26 (bv. foto toevoegen/verwijderen, timer starten/
/// pauzeren) is deze ronde geïnstrumenteerd; dat kan later incrementeel
/// aangevuld worden zonder schema-wijziging.
model AuditLog {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  /// Bv. "WORK_ORDER_SIGNED", "PAYROLL_BATCH_CREATED" — vrije, leesbare code, geen enum (voorkomt een migratie bij elke nieuwe actie).
  action     String
  entityType String @map("entity_type")
  entityId   String @map("entity_id")
  /// Vrije JSON met actie-specifieke details (bv. { "employeeDisplayName": "...", "amountCents": 1234 }) — bewust nooit gevoelige tokens/wachtwoorden.
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}
